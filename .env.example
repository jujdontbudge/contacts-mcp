# Node 24 loads <repo-root>/.env at CLI startup. Existing process env wins.
# Select only channels you intend to use. Empty disables all adapters.
CONTACTS_CHANNELS=
# Optional; use an absolute path when overriding the repo-root data/contacts.db.
# CONTACTS_DB=/absolute/path/to/contacts-mcp/data/contacts.db

# HTTP daemon (serve). Set a private random bearer token before starting.
CONTACTS_HTTP_HOST=127.0.0.1
CONTACTS_HTTP_PORT=8787
CONTACTS_HTTP_TOKEN=

# iMessage: imsg installed on the Mac, Full Disk Access + Messages Automation.
CONTACTS_IMSG_PATH=/opt/homebrew/bin/imsg

# Instagram: Beeper Desktop running with the intended connected account.
BEEPER_ACCESS_TOKEN=
BEEPER_BASE_URL=http://localhost:23373
BEEPER_INSTAGRAM_ACCOUNT_ID=

# Email: verified Resend sender and Receiving setup. Both keys are required.
CONTACTS_EMAIL_FROM=outreach@excerlock.com
CONTACTS_EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_FULL_API_KEY=

# TikTok: Zernio-connected eligible TikTok Business account with inbox access.
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_BASE_URL=https://zernio.com/api

# Hourly outgoing limits. Zero blocks sends; pending sends reserve slots.
CONTACTS_RATE_LIMIT_IMESSAGE=60
CONTACTS_RATE_LIMIT_INSTAGRAM=20
CONTACTS_RATE_LIMIT_EMAIL=60
CONTACTS_RATE_LIMIT_TIKTOK=10

# Poll delay after each completed pass; live listeners reconcile between polls.
CONTACTS_SYNC_INTERVAL_IMESSAGE_MS=30000
CONTACTS_SYNC_INTERVAL_INSTAGRAM_MS=300000
CONTACTS_SYNC_INTERVAL_EMAIL_MS=120000
CONTACTS_SYNC_INTERVAL_TIKTOK_MS=120000

# Instagram transport: beeper (default), official, or both.
CONTACTS_INSTAGRAM_TRANSPORT=beeper
# Official: Instagram API with Instagram Login; long-lived professional-account token.
IG_ACCESS_TOKEN=
# Optional; resolves via /me if omitted. Set before first sync for a stable account key.
IG_USER_ID=
IG_GRAPH_VERSION=v25.0
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
# Refreshed tokens live privately in SQLite channel_secrets, never sync_status.
